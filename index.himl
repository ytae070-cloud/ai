<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#F7F7FB">
  <meta name="description" content="아이디어 한 줄로 발표자료, 포스터, 제안서, 웹페이지, 예산 분석까지. AI Creative Agent Team이 한 번에 만듭니다.">
  <title>AI Creative Agent Team — One idea, five deliverables.</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap">
  <script src="https://cdn.botframework.com/botframework-webchat/4.18.0/webchat.js"></script>

  <style>
    /* 기본 디자인 시스템 */
    :root {
      color-scheme: light;
      --bg: #F7F7FB;
      --ink: #14142B;
      --muted: #6B6B80;
      --line: rgba(20,20,43,.08);
      --glass: rgba(255,255,255,.55);
      --purple: #8B5CF6;
      --brand: linear-gradient(120deg,#6E8BFF,#A77BFF 40%,#FF8AC8 70%,#FFB37A);
      --brand-text: linear-gradient(120deg,#4F6BFF,#8B5CF6 40%,#EC4899 70%,#FF7A45);
      --shadow: 0 30px 80px -30px rgba(76,70,160,.25);
      --ease: cubic-bezier(.2,1.3,.3,1);
      --page: 1160px;
    }

    * { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 96px;
      -webkit-text-size-adjust: 100%;
    }

    body {
      margin: 0;
      min-width: 320px;
      overflow-x: clip;
      color: var(--ink);
      background: var(--bg);
      font-family: "Pretendard Variable", Pretendard, -apple-system,
        BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    body::after {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 100;
      pointer-events: none;
      opacity: .04;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.6'/%3E%3C/svg%3E");
    }

    a { color: inherit; text-decoration: none; }
    button, textarea { font: inherit; }
    button { color: inherit; }
    button:focus-visible, a:focus-visible, textarea:focus-visible {
      outline: 3px solid rgba(110,139,255,.65);
      outline-offset: 4px;
    }

    img, svg { max-width: 100%; }

    p, h1, h2, h3, li {
      word-break: keep-all;
      overflow-wrap: anywhere;
    }

    .container {
      width: min(var(--page), calc(100% - 48px));
      margin-inline: auto;
    }

    .glass {
      background: rgba(255,255,255,.55);
      -webkit-backdrop-filter: blur(24px) saturate(160%);
      backdrop-filter: blur(24px) saturate(160%);
      border: 1px solid rgba(255,255,255,.7);
      box-shadow: inset 0 1px 1px rgba(255,255,255,.85), var(--shadow);
    }

    .eyebrow {
      display: block;
      margin-bottom: 12px;
      color: #7161B7;
      font: italic 24px/1.2 "Instrument Serif", Georgia, serif;
      letter-spacing: -.01em;
    }

    .section-heading {
      max-width: 760px;
      margin: 0 auto 46px;
      text-align: center;
    }

    .section-heading h2 {
      margin: 0;
      font-size: clamp(32px,4.2vw,56px);
      font-weight: 800;
      letter-spacing: -.04em;
      line-height: 1.1;
      text-wrap: balance;
    }

    .section-heading p {
      max-width: 600px;
      margin: 18px auto 0;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.8;
    }

    .gradient-text {
      color: transparent;
      background: var(--brand-text);
      background-clip: text;
      -webkit-background-clip: text;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 46px;
      padding: 0 21px;
      border-radius: 999px;
      border: 1px solid transparent;
      white-space: nowrap;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: transform .35s var(--ease), box-shadow .25s, background .25s;
    }

    .pill:hover { transform: translateY(-2px); }

    .pill-dark {
      color: white;
      background: var(--ink);
      box-shadow: 0 8px 24px -12px rgba(20,20,43,.6);
    }

    .pill-dark:hover { background: #292846; }

    .pill-glass {
      color: var(--ink);
      background: rgba(255,255,255,.55);
      border-color: rgba(255,255,255,.85);
      -webkit-backdrop-filter: blur(18px);
      backdrop-filter: blur(18px);
    }

    .section {
      padding-block: 112px;
      scroll-margin-top: 96px;
    }

    /* 고정 내비게이션 */
    .nav-wrap {
      position: fixed;
      top: 12px;
      left: 0;
      right: 0;
      z-index: 90;
      display: flex;
      justify-content: center;
      padding-inline: 12px;
      pointer-events: none;
    }

    .nav {
      width: min(1080px, 100%);
      min-height: 62px;
      padding: 8px 10px 8px 17px;
      display: flex;
      align-items: center;
      gap: 20px;
      border-radius: 999px;
      pointer-events: auto;
      background: rgba(255,255,255,.76);
      -webkit-backdrop-filter: blur(24px) saturate(160%);
      backdrop-filter: blur(24px) saturate(160%);
      border: 1px solid rgba(255,255,255,.85);
      box-shadow: 0 8px 36px rgba(59,48,120,.09), inset 0 1px 1px white;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 1 1 auto;
      min-width: 0;
      font-size: 14px;
      font-weight: 800;
      letter-spacing: -.04em;
      white-space: nowrap;
    }

    .brand-mark {
      position: relative;
      width: 31px;
      height: 31px;
      flex: none;
      border-radius: 50%;
      background: var(--brand);
      box-shadow: inset 0 1px 2px rgba(255,255,255,.8);
    }

    .brand-mark::after {
      content: "";
      position: absolute;
      width: 10px;
      height: 10px;
      top: 5px;
      right: 5px;
      border-radius: 50%;
      background: rgba(255,255,255,.85);
      filter: blur(1px);
    }

    .nav-links {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 27px;
      flex: none;
    }

    .nav-links a {
      color: #66667D;
      font-size: 13px;
      font-weight: 650;
      white-space: nowrap;
      transition: color .2s;
    }

    .nav-links a:hover,
    .nav-links a.active { color: var(--ink); }

    .nav-cta { flex: none; min-height: 43px; padding-inline: 18px; }

    /* 히어로 메시 패널 */
    .hero-shell {
      padding: 94px 12px 0;
    }

    .mesh {
      background:
        radial-gradient(circle at 16% 18%, #8EA2FF 0 14%, transparent 32%),
        radial-gradient(circle at 78% 9%, #FFB3D9 0 13%, transparent 30%),
        radial-gradient(circle at 66% 62%, #FFD3A8 0 16%, transparent 34%),
        radial-gradient(circle at 25% 74%, #9BE3FF 0 15%, transparent 32%),
        radial-gradient(circle at 50% 32%, #C4A5FF 0 16%, transparent 36%),
        linear-gradient(135deg, #fff, #F5F0FF 40%, #FFF7F0);
    }

    .hero {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      min-height: 0;
      padding: 30px 24px 28px;
      border-radius: 36px;
      text-align: center;
      background-color: #EDE6FF;
    }

    .hero::before,
    .hero::after {
      content: "";
      position: absolute;
      z-index: -1;
      border-radius: 50%;
      pointer-events: none;
      will-change: transform;
    }

    .hero::before {
      width: 440px;
      height: 440px;
      top: -180px;
      left: -90px;
      background: radial-gradient(circle,rgba(112,141,255,.62),rgba(112,141,255,0) 70%);
      animation: blob-drift 24s ease-in-out infinite alternate;
    }

    .hero::after {
      width: 520px;
      height: 520px;
      right: -170px;
      bottom: -240px;
      background: radial-gradient(circle,rgba(255,135,198,.65),rgba(255,135,198,0) 70%);
      animation: blob-drift 29s ease-in-out infinite alternate-reverse;
    }

    @keyframes blob-drift {
      from { transform: translate3d(-10px,0,0) scale(1); }
      to { transform: translate3d(45px,30px,0) scale(1.12); }
    }

    .hero-content {
      position: relative;
      z-index: 1;
      max-width: 940px;
      margin-inline: auto;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 15px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,.8);
      background: rgba(255,255,255,.52);
      -webkit-backdrop-filter: blur(18px);
      backdrop-filter: blur(18px);
      box-shadow: inset 0 1px 1px white;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }

    .hero-badge-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #6B68E8;
      box-shadow: 0 0 12px rgba(107,104,232,.6);
    }

    .hero-kicker {
      margin: 12px 0 7px;
      color: #5246A6;
      font: italic clamp(20px,2.5vw,29px)/1.2 "Instrument Serif", Georgia, serif;
    }

    .hero h1 {
      max-width: 900px;
      margin: 0 auto;
      font-size: clamp(40px,6vw,76px);
      font-weight: 800;
      letter-spacing: -.065em;
      line-height: 1.08;
      text-wrap: balance;
    }

    .hero-description {
      max-width: 620px;
      margin: 14px auto 20px;
      color: #4F4A69;
      font-size: clamp(13px,1.5vw,16px);
      line-height: 1.7;
    }

    /* 실제 채팅 카드 */
    .chat-card {
      position: relative;
      width: min(860px, 100%);
      margin-inline: auto;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      border-radius: 24px;
      border: 1px solid rgba(255,255,255,.86);
      background: rgba(255,255,255,.66);
      -webkit-backdrop-filter: blur(30px) saturate(160%);
      backdrop-filter: blur(30px) saturate(160%);
      box-shadow: 0 28px 70px -35px rgba(62,49,142,.35),
        inset 0 1px 1px white;
      text-align: left;
      transition: box-shadow .3s;
    }

    .chat-card > * { flex: none; }

    .chat-windowbar {
      height: 46px;
      padding: 0 13px;
      display: flex;
      align-items: center;
      gap: 9px;
      border-bottom: 1px solid rgba(20,20,43,.055);
      background: rgba(255,255,255,.24);
    }

    .window-dots {
      display: flex;
      gap: 5px;
      flex: none;
    }

    .window-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #D6D5E1;
    }

    .window-dot:first-child { background: #FFB3AD; }
    .window-dot:nth-child(2) { background: #F7D58D; }
    .window-dot:nth-child(3) { background: #9DDBB0; }

    .window-title {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 11px;
      font-weight: 750;
    }

    .connection-status {
      display: flex;
      align-items: center;
      gap: 5px;
      min-width: 0;
      margin-left: auto;
      color: #858499;
      font-size: 10px;
      white-space: nowrap;
    }

    .connection-dot {
      width: 6px;
      height: 6px;
      flex: none;
      border-radius: 50%;
      background: #A5A4B7;
    }

    body.is-connected .connection-dot {
      background: #42B883;
      box-shadow: 0 0 8px rgba(66,184,131,.4);
    }

    .new-chat {
      flex: none;
      padding: 6px 10px;
      border: 1px solid rgba(255,255,255,.85);
      border-radius: 999px;
      background: rgba(255,255,255,.58);
      font-size: 10px;
      font-weight: 650;
      cursor: pointer;
      white-space: nowrap;
    }

    #webchat {
      height: 200px;
      min-height: 0;
      overflow-y: auto;
      overflow-x: hidden;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      scrollbar-color: rgba(111,103,170,.18) transparent;
      text-align: left;
    }

    /* Web Chat 기본 요소 및 메시지 */
    #webchat,
    #webchat > div {
      background: transparent !important;
    }

    #webchat .webchat__basic-transcript,
    #webchat .webchat__basic-transcript__transcript {
      background: transparent !important;
    }

    #webchat .webchat__basic-transcript__transcript {
      padding: 12px 15px 8px !important;
    }

    #webchat .webchat__stacked-layout {
      padding: 3px 0 !important;
    }

    #webchat .webchat__stacked-layout__message-row {
      margin-block: 5px !important;
    }

    #webchat .webchat__stacked-layout__content {
      max-width: 100% !important;
    }

    #webchat .webchat__bubble {
      max-width: 100% !important;
    }

    #webchat .webchat__bubble__content {
      padding: 0 !important;
      border: 0 !important;
      background: transparent !important;
      color: var(--ink) !important;
      font-size: 13px;
      line-height: 1.7;
    }

    #webchat .webchat__bubble--from-user .webchat__bubble__content,
    #webchat .webchat__bubble--from-user {
      background: linear-gradient(135deg,#EEF0FF,#FBEFFF) !important;
      border-radius: 18px !important;
    }

    #webchat .webchat__bubble--from-user .webchat__bubble__content {
      padding: 10px 14px !important;
    }

    #webchat .webchat__bubble--from-user .webchat__bubble__content,
    #webchat .webchat__bubble--from-user .webchat__bubble__content * {
      color: #292444 !important;
    }

    #webchat .webchat__stacked-layout:not(.webchat__stacked-layout--from-user) .webchat__stacked-layout__status {
      display: none !important;
    }

    #webchat .webchat__typing-indicator { display: none !important; }

    #webchat .webchat__render-markdown {
      word-break: keep-all;
      overflow-wrap: anywhere;
      line-height: 1.7;
    }

    #webchat .webchat__render-markdown h1,
    #webchat .webchat__render-markdown h2,
    #webchat .webchat__render-markdown h3 {
      margin: 15px 0 8px;
      font-weight: 800;
      letter-spacing: -.035em;
      line-height: 1.35;
    }

    #webchat .webchat__render-markdown h1 { font-size: 23px; }
    #webchat .webchat__render-markdown h2 { font-size: 19px; }
    #webchat .webchat__render-markdown h3 { font-size: 16px; }

    #webchat .webchat__render-markdown p { margin: 6px 0 10px; }
    #webchat .webchat__render-markdown ul,
    #webchat .webchat__render-markdown ol {
      padding-left: 21px;
      margin: 8px 0 12px;
    }

    #webchat .webchat__render-markdown li { padding-left: 2px; margin: 4px 0; }
    #webchat .webchat__render-markdown a { color: #6654D9; text-decoration: underline; }
    #webchat .webchat__render-markdown strong { font-weight: 800; }

    #webchat .webchat__render-markdown table {
      display: block;
      max-width: 100%;
      overflow-x: auto;
      border-collapse: collapse;
      border-spacing: 0;
      margin: 12px 0;
      font-variant-numeric: tabular-nums;
    }

    #webchat .webchat__render-markdown th,
    #webchat .webchat__render-markdown td {
      padding: 9px 18px 9px 0;
      border-bottom: 1px solid rgba(20,20,43,.08);
      white-space: nowrap;
    }

    #webchat .webchat__render-markdown th {
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
    }

    #webchat .webchat__stacked-layout__attachment-row {
      margin-top: 8px !important;
    }

    #webchat .webchat__stacked-layout__attachment,
    #webchat .webchat__stacked-layout__attachment .webchat__bubble__content {
      background: none !important;
      border: 0 !important;
      overflow: visible !important;
    }

    #webchat .webchat__stacked-layout__content:has(.webchat__fileContent) {
      overflow: visible !important;
    }

    #webchat .webchat__fileContent { padding: 0 !important; }

    #webchat .webchat__fileContent__buttonLink {
      display: flex !important;
      align-items: center;
      gap: 12px;
      height: 56px;
      padding: 0 18px 0 12px;
      border-radius: 18px;
      text-decoration: none;
      color: var(--ink);
      background: rgba(255,255,255,.72);
      -webkit-backdrop-filter: blur(24px) saturate(160%);
      backdrop-filter: blur(24px) saturate(160%);
      border: 1px solid rgba(255,255,255,.8);
      box-shadow: 0 10px 24px -16px rgba(76,70,160,.3), inset 0 1px 1px #fff;
    }

    #webchat .webchat__fileContent__buttonLink::before {
      content: "FILE";
      flex: none;
      padding: 5px 8px;
      border-radius: 999px;
      background: linear-gradient(120deg,#EEF0FF,#FBEFFF);
      color: #5B4BC4;
      font: 600 10.5px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: .04em;
    }

    #webchat a[download$=".pptx" i]::before { content: "PPTX"; }
    #webchat a[download$=".docx" i]::before { content: "DOCX"; }
    #webchat a[download$=".xlsx" i]::before { content: "XLSX"; }
    #webchat a[download$=".html" i]::before { content: "HTML"; }

    #webchat .webchat__fileContent__badge {
      flex: 1;
      min-width: 0;
      background: none !important;
      padding: 0 !important;
    }

    #webchat .webchat__fileContent__fileName {
      font: 13px ui-monospace, SFMono-Regular, Menlo, monospace !important;
      color: var(--ink) !important;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    #webchat .webchat__fileContent__downloadIcon {
      flex: none;
      box-sizing: content-box;
      width: 16px;
      height: 16px;
      padding: 0;
      fill: var(--muted);
      color: var(--muted);
    }

    /* 对话脚部：示例、状态、建议和输入 */
    .chat-foot {
      padding: 0 15px 13px;
    }

    .example-row,
    .suggested-row {
      display: flex;
      gap: 7px;
      align-items: center;
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding: 7px 0;
    }

    .example-row::-webkit-scrollbar,
    .suggested-row::-webkit-scrollbar,
    .marquee-track::-webkit-scrollbar { display: none; }

    .example-chip,
    .suggested-chip {
      flex: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 30px;
      padding: 0 11px;
      border: 1px solid rgba(255,255,255,.88);
      border-radius: 999px;
      background: rgba(255,255,255,.65);
      color: #59576F;
      font-size: 11px;
      font-weight: 600;
      white-space: nowrap;
      cursor: pointer;
      transition: background .2s, transform .25s var(--ease);
    }

    .example-chip:hover,
    .suggested-chip:hover {
      background: white;
      transform: translateY(-1px);
    }

    .working-status {
      display: none;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 7px 1px;
      color: #68617F;
      font-size: 11px;
    }

    body.is-working .working-status { display: flex; }

    .working-left {
      display: flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
    }

    .agent-dots { display: flex; gap: 3px; flex: none; }

    .agent-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: #A78BFA;
      animation: dot-pulse 1.2s ease-in-out infinite;
    }

    .agent-dot:nth-child(2) { animation-delay: .12s; }
    .agent-dot:nth-child(3) { animation-delay: .24s; }
    .agent-dot:nth-child(4) { animation-delay: .36s; }
    .agent-dot:nth-child(5) { animation-delay: .48s; }

    @keyframes dot-pulse {
      0%, 70%, 100% { opacity: .35; transform: scale(.8); }
      35% { opacity: 1; transform: scale(1.25); }
    }

    .working-message {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .working-time { flex: none; font-variant-numeric: tabular-nums; }

    .composer {
      position: relative;
      display: flex;
      align-items: flex-end;
      gap: 9px;
      min-height: 56px;
      padding: 7px 8px 7px 19px;
      border-radius: 28px;
      border: 1px solid rgba(255,255,255,.94);
      background: rgba(255,255,255,.76);
      box-shadow: 0 5px 24px -18px rgba(76,70,160,.3), inset 0 1px 1px white;
      transition: transform .3s var(--ease), box-shadow .3s;
    }

    .composer:focus-within {
      transform: translateY(-2px);
      box-shadow: 0 12px 32px -19px rgba(76,70,160,.38), inset 0 1px 1px white;
    }

    .composer textarea {
      flex: 1;
      width: 0;
      min-height: 39px;
      max-height: 156px;
      resize: none;
      padding: 10px 0;
      border: 0;
      outline: none;
      background: transparent;
      color: var(--ink);
      font-size: 13px;
      line-height: 1.5;
    }

    .composer textarea::placeholder { color: #9693A9; }
    .composer textarea:disabled { cursor: not-allowed; opacity: .6; }

    .send-button {
      display: grid;
      place-items: center;
      flex: none;
      width: 40px;
      height: 40px;
      margin-bottom: 1px;
      border: 0;
      border-radius: 50%;
      background: var(--ink);
      color: white;
      font-size: 23px;
      line-height: 1;
      cursor: pointer;
      transition: transform .3s var(--ease), opacity .2s, background .2s;
    }

    .send-button:hover:not(:disabled) {
      transform: translateY(-2px);
      background: #383451;
    }

    .send-button:disabled { opacity: .22; cursor: not-allowed; }

    /* 작업 중 오로라 테두리 */
    @property --aurora {
      syntax: "<angle>";
      inherits: false;
      initial-value: 0deg;
    }

    .composer::before {
      content: "";
      position: absolute;
      inset: -1px;
      padding: 1.5px;
      border-radius: inherit;
      pointer-events: none;
      opacity: 0;
      transition: opacity .6s;
      background: conic-gradient(from var(--aurora),#a5b4fc,#f0abfc,#fda4af,#fcd34d,#86efac,#67e8f9,#a5b4fc);
      -webkit-mask: linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      animation: aurora 6s linear infinite;
    }

    body.is-working .composer::before { opacity: .8; }
    @keyframes aurora { to { --aurora: 360deg; } }

    .chat-hint {
      margin: 8px 0 0;
      color: #9390A4;
      font-size: 10px;
      line-height: 1.5;
      text-align: center;
    }

    .error-panel {
      display: none;
      padding: 20px;
      text-align: center;
      color: #615C77;
      font-size: 13px;
      line-height: 1.7;
    }

    body.is-error .error-panel { display: block; }
    body.is-error .composer { display: none; }

    .error-detail {
      margin: 8px 0 14px;
      color: #888399;
      font: 11px/1.6 ui-monospace, SFMono-Regular, Menlo, monospace;
      overflow-wrap: anywhere;
    }

    .retry-button {
      padding: 8px 15px;
      border: 1px solid rgba(255,255,255,.9);
      border-radius: 999px;
      background: rgba(255,255,255,.75);
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }

    /* 히어로 아래 기술 띠 */
    .logo-strip {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px 23px;
      padding: 20px 10px 0;
      color: rgba(43,37,76,.58);
      font-size: 11px;
      font-weight: 650;
      letter-spacing: -.01em;
    }

    .logo-divider { color: rgba(43,37,76,.25); }

    /* 숫자 띠 */
    .stats {
      display: grid;
      grid-template-columns: repeat(4,minmax(0,1fr));
      gap: 0;
      margin-top: 35px;
      padding: 25px 0;
      border-block: 1px solid var(--line);
    }

    .stat {
      padding: 7px 15px;
      text-align: center;
      border-right: 1px solid var(--line);
    }

    .stat:last-child { border-right: 0; }

    .stat-number {
      font-size: clamp(27px,3.4vw,41px);
      font-weight: 800;
      letter-spacing: -.06em;
      line-height: 1.1;
    }

    .stat-label {
      margin-top: 7px;
      color: var(--muted);
      font-size: 12px;
      font-weight: 550;
    }

    /* 등장 효과 */
    .reveal-ready [data-reveal] {
      opacity: 0;
      filter: blur(10px);
      transform: translateY(22px);
      transition: opacity .7s ease, filter .7s ease, transform .8s var(--ease);
      transition-delay: var(--delay,0ms);
    }

    .reveal-ready [data-reveal].is-visible {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }

    /* 다섯 가지 결과물: 벤토 그리드 */
    .features-section { padding-top: 110px; }

    .bento {
      display: grid;
      grid-template-columns: repeat(6,minmax(0,1fr));
      gap: 16px;
    }

    .feature-card {
      grid-column: span 2;
      position: relative;
      min-width: 0;
      overflow: hidden;
      padding: 22px;
      border-radius: 25px;
      border: 1px solid rgba(255,255,255,.95);
      background: rgba(255,255,255,.58);
      box-shadow: 0 15px 45px -38px rgba(70,59,134,.32), inset 0 1px 1px white;
      transition: transform .4s var(--ease), box-shadow .35s;
    }

    .feature-card:nth-child(1),
    .feature-card:nth-child(2) { grid-column: span 3; }

    .feature-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 24px 55px -35px rgba(70,59,134,.38), inset 0 1px 1px white;
    }

    .feature-visual {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 180px;
      margin-bottom: 23px;
      overflow: hidden;
      border-radius: 18px;
      background: linear-gradient(135deg,#F2F0FF,#F9F5FF 55%,#FFF0F5);
    }

    .feature-card:nth-child(2) .feature-visual { background: linear-gradient(135deg,#F9ECFF,#E7D9FF 50%,#FFDCE8); }
    .feature-card:nth-child(3) .feature-visual { background: linear-gradient(135deg,#E8F3FF,#EDE7FF); }
    .feature-card:nth-child(4) .feature-visual { background: linear-gradient(135deg,#FFF1E9,#FFE7F0); }
    .feature-card:nth-child(5) .feature-visual { background: linear-gradient(135deg,#E9F7F5,#E8E9FF); }

    .feature-number {
      display: inline-block;
      margin-bottom: 8px;
      color: #8B78D2;
      font: italic 18px/1 "Instrument Serif", Georgia, serif;
    }

    .feature-card h3 {
      margin: 0 0 9px;
      font-size: 21px;
      font-weight: 800;
      letter-spacing: -.045em;
      line-height: 1.3;
    }

    .feature-card p {
      min-height: 44px;
      margin: 0 0 16px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.75;
    }

    .file-name {
      display: inline-flex;
      align-items: center;
      max-width: 100%;
      padding: 8px 11px;
      border-radius: 9px;
      border: 1px solid rgba(20,20,43,.07);
      background: rgba(255,255,255,.72);
      color: #68617F;
      font: 11px ui-monospace, SFMono-Regular, Menlo, monospace;
      overflow-wrap: anywhere;
    }

    /* 발표자료 목업 */
    .slides-stack {
      position: relative;
      width: 235px;
      height: 128px;
      transition: transform .5s var(--ease);
    }

    .slide {
      position: absolute;
      width: 158px;
      height: 106px;
      padding: 13px;
      border-radius: 8px;
      background: rgba(255,255,255,.96);
      box-shadow: 0 12px 30px rgba(57,45,118,.13);
      border: 1px solid rgba(255,255,255,.9);
      transition: transform .5s var(--ease);
    }

    .slide-one { left: 4px; top: 14px; transform: rotate(-12deg); }
    .slide-two { left: 39px; top: 9px; transform: rotate(-4deg); }
    .slide-three { left: 74px; top: 4px; transform: rotate(5deg); }

    .slide-accent {
      width: 36px;
      height: 4px;
      margin-bottom: 9px;
      border-radius: 5px;
      background: var(--brand);
    }

    .slide-line {
      width: 75%;
      height: 4px;
      margin-top: 6px;
      border-radius: 4px;
      background: #E7E5F1;
    }

    .slide-line.short { width: 45%; }
    .slide-shape {
      position: absolute;
      right: 13px;
      bottom: 12px;
      width: 35px;
      height: 27px;
      border-radius: 5px;
      background: linear-gradient(135deg,#9DAEFF,#DDA6FF);
    }

    .feature-card:hover .slide-one { transform: translateX(-15px) rotate(-18deg); }
    .feature-card:hover .slide-two { transform: translateX(-2px) rotate(-7deg); }
    .feature-card:hover .slide-three { transform: translateX(14px) rotate(10deg); }

    /* 포스터 목업 */
    .poster-mock {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      width: 105px;
      height: 150px;
      padding: 14px 12px;
      overflow: hidden;
      border-radius: 7px;
      color: white;
      background:
        radial-gradient(circle at 80% 20%,rgba(255,171,216,.85),transparent 42%),
        radial-gradient(circle at 20% 80%,rgba(83,105,255,.9),transparent 45%),
        linear-gradient(150deg,#292066,#7C48B9 60%,#EC7EAB);
      box-shadow: 0 14px 30px rgba(88,57,150,.24);
      transition: transform .5s var(--ease);
    }

    .poster-mock::before {
      content: "";
      position: absolute;
      width: 80px;
      height: 80px;
      right: -23px;
      top: 36px;
      border: 1px solid rgba(255,255,255,.7);
      border-radius: 50%;
      box-shadow: 0 0 0 9px rgba(255,255,255,.08),0 0 0 20px rgba(255,255,255,.06);
    }

    .poster-small { position: relative; font-size: 6px; letter-spacing: .13em; }
    .poster-title {
      position: relative;
      font-size: 23px;
      font-weight: 900;
      line-height: .98;
      letter-spacing: -.07em;
    }

    .poster-bottom { position: relative; font-size: 6px; opacity: .85; }
    .feature-card:hover .poster-mock { transform: rotate(-4deg) translateY(-5px); }

    /* 제안서 목업 */
    .document-mock {
      width: 130px;
      height: 151px;
      overflow: hidden;
      border-radius: 7px;
      background: white;
      box-shadow: 0 12px 28px rgba(70,59,134,.13);
      transition: transform .5s var(--ease);
    }

    .doc-cover {
      height: 47px;
      padding: 10px;
      color: white;
      background: linear-gradient(120deg,#FF9A8B,#FF6A88,#B77BFF);
      font-size: 10px;
      font-weight: 800;
    }

    .doc-content { padding: 12px; }
    .doc-heading { width: 64%; height: 5px; margin-bottom: 10px; border-radius: 3px; background: #D8D5E8; }
    .doc-line { width: 100%; height: 3px; margin-top: 6px; border-radius: 3px; background: #ECEAF2; }
    .doc-line.short { width: 65%; }
    .doc-table { display: flex; gap: 3px; margin-top: 12px; }
    .doc-table span { flex: 1; height: 17px; border-radius: 2px; background: #F1EEFA; }
    .feature-card:hover .document-mock { transform: translateY(-5px) rotate(2deg); }

    /* 웹페이지 목업 */
    .browser-mock {
      width: min(260px,90%);
      height: 145px;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,.95);
      border-radius: 10px;
      background: rgba(255,255,255,.88);
      box-shadow: 0 14px 30px rgba(70,59,134,.12);
      transition: transform .5s var(--ease);
    }

    .browser-bar {
      height: 22px;
      display: flex;
      align-items: center;
      gap: 4px;
      padding-inline: 9px;
      background: #FAF9FD;
      border-bottom: 1px solid #F0EEF6;
    }

    .browser-dot { width: 5px; height: 5px; border-radius: 50%; background: #D2CFE1; }

    .browser-address {
      width: 65%;
      height: 9px;
      margin-left: 9px;
      border-radius: 6px;
      background: #F0EDF7;
    }

    .browser-content {
      height: 123px;
      padding: 13px;
      background: linear-gradient(135deg,#F0F1FF,#F9E8F4);
    }

    .browser-nav { display: flex; justify-content: space-between; align-items: center; }
    .browser-logo { width: 37px; height: 6px; border-radius: 3px; background: #8B78D2; }
    .browser-menu { width: 46px; height: 5px; border-radius: 3px; background: #D9D4E9; }
    .browser-head { margin-top: 13px; width: 76%; height: 12px; border-radius: 3px; background: #8174D1; }
    .browser-text { width: 58%; height: 4px; margin-top: 7px; border-radius: 3px; background: #D0CBE5; }
    .browser-cards { display: flex; gap: 6px; margin-top: 10px; }
    .browser-card { flex: 1; height: 34px; border-radius: 5px; background: rgba(255,255,255,.82); }
    .feature-card:hover .browser-mock { transform: translateY(-5px) scale(1.02); }

    /* 예산 목업 */
    .budget-mock {
      width: min(260px,95%);
      padding: 15px;
      border-radius: 12px;
      background: rgba(255,255,255,.88);
      border: 1px solid rgba(255,255,255,.95);
      box-shadow: 0 12px 30px rgba(70,59,134,.11);
      transition: transform .5s var(--ease);
    }

    .budget-caption { color: #838097; font-size: 9px; }
    .budget-amount { margin-top: 5px; font-size: 24px; font-weight: 850; letter-spacing: -.055em; }
    .budget-tag { display: inline-block; margin-left: 5px; color: #209B72; font-size: 8px; font-weight: 700; }

    .budget-bars {
      display: flex;
      align-items: flex-end;
      gap: 8px;
      height: 48px;
      margin-top: 12px;
      padding-bottom: 2px;
      border-bottom: 1px solid #EAE7F2;
    }

    .budget-bar {
      flex: 1;
      height: var(--bar-height);
      min-height: 3px;
      border-radius: 4px 4px 1px 1px;
      background: linear-gradient(180deg,#B7A2FF,#7E8DFF);
      transform: scaleY(0);
      transform-origin: bottom;
      transition: transform 1.1s var(--ease);
    }

    .is-visible .budget-bar { transform: scaleY(1); }
    .budget-bar:nth-child(2) { transition-delay: .1s; }
    .budget-bar:nth-child(3) { transition-delay: .2s; }
    .budget-bar:nth-child(4) { transition-delay: .3s; }
    .budget-bar:nth-child(5) { transition-delay: .4s; }

    .feature-card:hover .budget-mock { transform: translateY(-4px); }

    /* 작동 방식 */
    .how-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 34px;
      align-items: stretch;
    }

    .orbit-card {
      min-width: 0;
      min-height: 390px;
      display: grid;
      place-items: center;
      overflow: hidden;
      border-radius: 28px;
      border: 1px solid rgba(255,255,255,.95);
      background:
        radial-gradient(circle at 50% 50%,rgba(190,173,255,.3),transparent 52%),
        rgba(255,255,255,.55);
      box-shadow: inset 0 1px 1px white,0 20px 50px -40px rgba(76,70,160,.3);
    }

    /* 요청한 궤도 애니메이션의 transform/rotate 규칙 유지 */
    .orbit {
      --r: 150px;
      position: relative;
      width: calc(var(--r) * 2);
      aspect-ratio: 1;
      margin: 48px auto;
    }

    .orbit-ring {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 1px dashed rgba(20,20,43,.16);
      animation: orbit-spin 40s linear infinite;
    }

    .orbit .agent {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: rotate(var(--a)) translateX(var(--r)) rotate(calc(-1 * var(--a)));
    }

    .orbit .agent b {
      position: absolute;
      translate: -50% -50%;
      white-space: nowrap;
      padding: 8px 12px;
      border-radius: 999px;
      font: 600 12px ui-monospace, SFMono-Regular, Menlo, monospace;
      color: #5B4BC4;
      background: rgba(255,255,255,.8);
      border: 1px solid #fff;
      box-shadow: 0 5px 20px rgba(76,70,160,.08);
      animation: orbit-spin 40s linear infinite reverse;
    }

    .orbit .leader {
      position: absolute;
      left: 50%;
      top: 50%;
      translate: -50% -50%;
      width: 112px;
      aspect-ratio: 1;
      border-radius: 50%;
      display: grid;
      place-items: center;
      font-weight: 800;
      color: white;
      background: linear-gradient(145deg,#8D9AFF,#A77BFF 55%,#F39DCB);
      border: 5px solid rgba(255,255,255,.75);
      box-shadow: 0 15px 40px rgba(109,94,215,.25),inset 0 2px 4px rgba(255,255,255,.6);
    }

    @keyframes orbit-spin { to { rotate: 360deg; } }

    .steps { display: flex; flex-direction: column; gap: 12px; }

    .step {
      display: flex;
      align-items: flex-start;
      gap: 15px;
      padding: 20px;
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,.95);
      background: rgba(255,255,255,.58);
      box-shadow: inset 0 1px 1px white;
      transition: transform .3s var(--ease), background .25s;
    }

    .step:hover { transform: translateX(4px); background: rgba(255,255,255,.83); }

    .step-number {
      flex: none;
      display: grid;
      place-items: center;
      width: 38px;
      height: 38px;
      border-radius: 13px;
      color: #6654D9;
      background: linear-gradient(135deg,#EEF0FF,#F8E7FF);
      font-size: 13px;
      font-weight: 800;
    }

    .step h3 { margin: 1px 0 6px; font-size: 16px; letter-spacing: -.035em; }
    .step p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.8; }

    /* 풀 블리드 디자인 띠 */
    .design-band {
      position: relative;
      overflow: hidden;
      padding: 100px 24px 94px;
      color: white;
      background: linear-gradient(115deg,#5B3DF5 0%,#A849EF 35%,#FF4FA3 68%,#FF9F45 100%);
    }

    .design-band::before,
    .design-band::after {
      content: "";
      position: absolute;
      width: 460px;
      height: 460px;
      border-radius: 50%;
      pointer-events: none;
    }

    .design-band::before {
      top: -320px;
      left: 15%;
      background: radial-gradient(circle,rgba(255,255,255,.28),transparent 70%);
    }

    .design-band::after {
      bottom: -340px;
      right: 8%;
      background: radial-gradient(circle,rgba(255,221,187,.3),transparent 70%);
    }

    .design-inner { position: relative; z-index: 1; }

    .design-band .section-heading { margin-bottom: 40px; }
    .design-band .eyebrow { color: rgba(255,255,255,.83); }
    .design-band .section-heading p { color: rgba(255,255,255,.8); }

    .theme-grid {
      display: grid;
      grid-template-columns: repeat(5,minmax(0,1fr));
      gap: 12px;
    }

    .theme-card {
      min-width: 0;
      padding: 19px 15px;
      border-radius: 21px;
      border: 1px solid rgba(255,255,255,.45);
      background: rgba(255,255,255,.17);
      -webkit-backdrop-filter: blur(20px) saturate(150%);
      backdrop-filter: blur(20px) saturate(150%);
      box-shadow: inset 0 1px 1px rgba(255,255,255,.32);
      transition: transform .35s var(--ease),background .25s;
    }

    .theme-card:hover { transform: translateY(-5px); background: rgba(255,255,255,.25); }

    .theme-swatches { display: flex; gap: 8px; margin-bottom: 18px; }

    .swatch {
      width: 35px;
      height: 35px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,.65);
      box-shadow: inset 0 1px 2px rgba(255,255,255,.3);
    }

    .theme-card h3 { margin: 0 0 7px; font-size: 15px; font-weight: 800; }
    .theme-card p { margin: 0; color: rgba(255,255,255,.8); font-size: 11px; line-height: 1.65; }
    .theme-colors { display: block; margin-top: 12px; color: rgba(255,255,255,.75); font: 9px/1.7 ui-monospace,monospace; overflow-wrap: anywhere; }

    /* 프롬프트 마키 */
    .prompts-section { overflow: hidden; padding-bottom: 100px; }

    .marquee-wrap {
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 100%;
      overflow: hidden;
    }

    .marquee-track {
      display: flex;
      width: max-content;
      gap: 11px;
      animation: marquee-left 38s linear infinite;
    }

    .marquee-track.reverse { animation-name: marquee-right; animation-duration: 43s; }
    .marquee-wrap:hover .marquee-track { animation-play-state: paused; }

    @keyframes marquee-left { to { transform: translateX(-50%); } }
    @keyframes marquee-right { from { transform: translateX(-50%); } to { transform: translateX(0); } }

    .prompt-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 49px;
      padding: 0 19px;
      border: 1px solid rgba(255,255,255,.95);
      border-radius: 999px;
      background: rgba(255,255,255,.68);
      -webkit-backdrop-filter: blur(20px);
      backdrop-filter: blur(20px);
      box-shadow: 0 8px 30px -24px rgba(76,70,160,.35),inset 0 1px 1px white;
      color: #4F4B6A;
      font-size: 13px;
      font-weight: 650;
      white-space: nowrap;
      cursor: pointer;
      transition: transform .3s var(--ease),background .25s;
    }

    .prompt-chip:hover { transform: translateY(-3px); background: white; }
    .prompt-chip::after { content: "↗"; color: #8B78D2; font-size: 12px; }

    /* 마지막 CTA */
    .cta-shell { padding: 0 12px 40px; }

    .cta-panel {
      position: relative;
      overflow: hidden;
      padding: 85px 24px 90px;
      border-radius: 36px;
      text-align: center;
      isolation: isolate;
    }

    .cta-panel::before {
      content: "";
      position: absolute;
      inset: -10%;
      z-index: -1;
      background: radial-gradient(circle at 80% 15%,rgba(255,145,204,.65),transparent 35%),
        radial-gradient(circle at 20% 80%,rgba(132,166,255,.72),transparent 38%);
      animation: blob-drift 25s ease-in-out infinite alternate;
    }

    .cta-panel .eyebrow { margin-bottom: 15px; }

    .cta-panel h2 {
      max-width: 800px;
      margin: 0 auto 27px;
      font-size: clamp(40px,6vw,76px);
      font-weight: 800;
      letter-spacing: -.06em;
      line-height: 1.1;
      text-wrap: balance;
    }

    .cta-button { min-height: 52px; padding-inline: 25px; font-size: 14px; }

    /* 푸터 */
    .footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 23px 0 30px;
      color: #858398;
      font-size: 11px;
    }

    .footer-brand { color: #56536B; font-weight: 750; }

    /* 떠 있는 작업 알림 */
    .floating-status {
      position: fixed;
      right: 20px;
      bottom: 20px;
      z-index: 85;
      display: none;
      align-items: center;
      gap: 9px;
      max-width: calc(100vw - 32px);
      padding: 12px 16px;
      border: 1px solid rgba(255,255,255,.9);
      border-radius: 999px;
      background: rgba(255,255,255,.82);
      -webkit-backdrop-filter: blur(24px) saturate(160%);
      backdrop-filter: blur(24px) saturate(160%);
      box-shadow: 0 15px 45px -20px rgba(76,70,160,.3),inset 0 1px 1px white;
      color: #57516E;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
      cursor: pointer;
      animation: float-in .5s var(--ease);
    }

    .floating-status.show { display: inline-flex; }

    .float-dot {
      width: 7px;
      height: 7px;
      flex: none;
      border-radius: 50%;
      background: #A78BFA;
    }

    body.is-working .float-dot { animation: dot-pulse 1.2s infinite; }

    @keyframes float-in {
      from { opacity: 0; transform: translateY(10px) scale(.95); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* 반응형 */
    @media (min-width: 1500px) {
      .hero { padding-top: 38px; padding-bottom: 32px; }
    }

    @media (max-width: 900px) {
      .nav-links { gap: 15px; }
      .nav-links a { font-size: 12px; }
      .theme-grid { grid-template-columns: repeat(3,minmax(0,1fr)); }
      .theme-card:nth-child(4), .theme-card:nth-child(5) { grid-column: span 1; }
      .feature-card { padding: 18px; }
      .how-grid { gap: 22px; }
    }

    @media (max-width: 600px) {
      .container { width: calc(100% - 32px); }
      .section { padding-block: 76px; }
      .section-heading { margin-bottom: 30px; }
      .section-heading p { font-size: 14px; }

      .nav-wrap { top: 8px; padding-inline: 8px; }
      .nav { min-height: 53px; gap: 8px; padding: 6px 7px 6px 11px; }
      .brand { gap: 7px; font-size: 11px; letter-spacing: -.045em; }
      .brand-mark { width: 27px; height: 27px; }
      .nav-links { display: none; }
      .nav-cta { min-height: 38px; padding-inline: 12px; font-size: 11px; }

      .hero-shell { padding: 70px 8px 0; }
      .hero { padding: 23px 11px 20px; border-radius: 27px; }
      .hero-badge { padding: 8px 11px; font-size: 10px; }
      .hero-kicker { margin: 11px 0 8px; font-size: 21px; }
      .hero h1 { font-size: clamp(36px,9.5vw,47px); line-height: 1.13; letter-spacing: -.065em; }
      .hero-description { max-width: 340px; margin: 12px auto 15px; font-size: 12px; line-height: 1.65; }

      .chat-card { border-radius: 19px; }
      .chat-windowbar { height: 42px; gap: 7px; padding-inline: 9px; }
      .window-title { font-size: 10px; }
      .connection-status { font-size: 9px; gap: 4px; }
      .new-chat { padding: 6px 8px; font-size: 9px; }
      .chat-foot { padding: 0 9px 10px; }
      .example-row { gap: 6px; padding: 6px 0; }
      .example-chip { min-height: 28px; padding-inline: 9px; font-size: 10px; }
      .composer { min-height: 52px; padding: 6px 6px 6px 14px; gap: 6px; }
      .composer textarea { min-height: 38px; font-size: 12px; }
      .send-button { width: 38px; height: 38px; }
      .chat-hint { font-size: 9px; }
      #webchat .webchat__basic-transcript__transcript { padding: 9px 10px 6px !important; }

      .logo-strip { gap: 8px 11px; padding-top: 15px; font-size: 9px; }
      .logo-divider { display: none; }

      .stats { grid-template-columns: repeat(2,minmax(0,1fr)); margin-top: 24px; padding-block: 10px; }
      .stat { padding: 13px 5px; }
      .stat:nth-child(2) { border-right: 0; }
      .stat:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
      .stat-number { font-size: 30px; }
      .stat-label { font-size: 11px; }

      .features-section { padding-top: 76px; }
      .bento { grid-template-columns: minmax(0,1fr); gap: 13px; }
      .feature-card,
      .feature-card:nth-child(1),
      .feature-card:nth-child(2) { grid-column: 1; padding: 17px; }
      .feature-visual { height: 160px; margin-bottom: 19px; }
      .feature-card h3 { font-size: 20px; }
      .feature-card p { min-height: 0; }
      .slides-stack { transform: scale(.92); }
      .feature-card:hover .slides-stack { transform: scale(.92); }

      .how-grid { grid-template-columns: minmax(0,1fr); gap: 20px; }
      .orbit-card { min-height: 310px; }
      .orbit { --r: 100px; margin: 36px auto; }
      .orbit .agent b { font-size: 10px; padding: 6px 9px; }
      .orbit .leader { width: 84px; }
      .step { padding: 17px; gap: 12px; }
      .step h3 { font-size: 15px; }
      .step p { font-size: 12px; }

      .design-band { padding: 77px 16px; }
      .theme-grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; }
      .theme-card { padding: 15px 12px; }
      .theme-card:last-child { grid-column: span 2; }
      .swatch { width: 30px; height: 30px; }
      .theme-card h3 { font-size: 14px; }

      .prompts-section { padding-bottom: 75px; }
      .prompt-chip { min-height: 43px; padding-inline: 15px; font-size: 12px; }

      .cta-shell { padding: 0 8px 20px; }
      .cta-panel { padding: 70px 14px; border-radius: 27px; }
      .cta-panel h2 { font-size: clamp(38px,10vw,48px); }
      .cta-button { min-height: 48px; }

      .footer { flex-direction: column; align-items: flex-start; padding: 22px 0; gap: 8px; }
      .floating-status { right: 12px; bottom: 12px; padding: 11px 13px; font-size: 11px; }

      body.is-started .chat-card { height: calc(100svh - 112px); }
      body.is-started .chat-card > #webchat { flex: 1 1 0; height: auto; min-height: 0; }
    }

    @media (max-width: 370px) {
      .brand { font-size: 10px; gap: 6px; }
      .nav-cta { padding-inline: 10px; font-size: 10px; }
      .hero h1 { font-size: 35px; }
      .connection-status { max-width: 68px; }
      .connection-label { overflow: hidden; text-overflow: ellipsis; }
      .theme-grid { gap: 8px; }
    }

    /* 작업 중에는 채팅창을 화면에 맞춤 */
    body.is-started .chat-card { height: calc(100svh - 112px); }
    body.is-started .chat-card > #webchat {
      flex: 1 1 0;
      height: auto;
      min-height: 0;
    }

    body.is-started .hero-shell { padding-top: 94px; }
    body.is-started .hero { padding-top: 18px; padding-bottom: 18px; }
    body.is-started .hero-kicker { margin-block: 6px; }
    body.is-started .hero h1 { font-size: clamp(34px,4vw,52px); }
    body.is-started .hero-description { margin-block: 8px 12px; }

    @media (max-width: 600px) {
      body.is-started .hero-shell { padding-top: 70px; }
      body.is-started .hero { padding-top: 15px; padding-bottom: 12px; }
      body.is-started .hero-badge { padding-block: 6px; }
      body.is-started .hero-kicker { font-size: 17px; margin-block: 5px; }
      body.is-started .hero h1 { font-size: clamp(28px,7vw,35px); }
      body.is-started .hero-description { font-size: 11px; margin-block: 6px 9px; }
      body.is-started .chat-hint { margin-top: 5px; }
    }

    /* 요청 시간과 결과 상태 */
    .working-long-note {
      display: none;
      color: #8B78A9;
      font-size: 10px;
    }

    body.is-working.is-working-long .working-long-note { display: inline; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
      }

      .reveal-ready [data-reveal] {
        opacity: 1;
        filter: none;
        transform: none;
      }
    }
  </style>
</head>

<body>
  <!-- 상단 내비게이션 -->
  <div class="nav-wrap">
    <nav class="nav glass" aria-label="메인 내비게이션">
      <a class="brand" href="#top" aria-label="AI Creative Agent Team 홈">
        <span class="brand-mark" aria-hidden="true"></span>
        <span>AI Creative Agent Team</span>
      </a>

      <div class="nav-links">
        <a href="#features">기능</a>
        <a href="#how">작동 방식</a>
        <a href="#design">디자인</a>
      </div>

      <button class="pill pill-dark nav-cta" type="button" data-chat-jump>
        지금 써 보기 <span aria-hidden="true">↗</span>
      </button>
    </nav>
  </div>

  <main id="top">
    <!-- 히어로: 실제 채팅창 -->
    <section class="hero-shell">
      <div class="hero mesh">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="hero-badge-dot" aria-hidden="true"></span>
            Copilot Studio 멀티 에이전트
          </div>

          <p class="hero-kicker">One idea, five deliverables.</p>

          <h1>
            한 줄의 아이디어,<br>
            <span class="gradient-text">다섯 개의 결과물.</span>
          </h1>

          <p class="hero-description">
            팀장 에이전트가 전문가 다섯에게 일을 나눠,<br>
            발표자료부터 예산 분석까지 한 번에 만들어 드려요.
          </p>

          <section class="chat-card" id="chat-card" aria-label="AI Creative Agent Team 대화창">
            <div class="chat-windowbar">
              <div class="window-dots" aria-hidden="true">
                <span class="window-dot"></span>
                <span class="window-dot"></span>
                <span class="window-dot"></span>
              </div>

              <span class="window-title">AI Creative Agent Team</span>

              <div class="connection-status" role="status" aria-live="polite">
                <span class="connection-dot" aria-hidden="true"></span>
                <span class="connection-label" id="connection-label">팀을 부르는 중…</span>
              </div>

              <button class="new-chat" id="new-chat" type="button">새 대화 ↻</button>
            </div>

            <!-- Web Chat이 메시지와 첨부 파일을 직접 렌더링 -->
            <div id="webchat" aria-label="대화 내용"></div>

            <div class="chat-foot">
              <div class="example-row" id="example-row" aria-label="예시 요청">
                <button class="example-chip" type="button" data-prompt="가을 학교 축제 기획해 줘">가을 학교 축제 기획해 줘</button>
                <button class="example-chip" type="button" data-prompt="탄소중립 캠페인 홍보물 만들어 줘">탄소중립 캠페인 홍보물 만들어 줘</button>
                <button class="example-chip" type="button" data-prompt="교사 AI 연수 프로그램 제안해 줘">교사 AI 연수 프로그램 제안해 줘</button>
              </div>

              <div class="working-status" id="working-status" role="status" aria-live="polite">
                <div class="working-left">
                  <span class="agent-dots" aria-hidden="true">
                    <span class="agent-dot"></span>
                    <span class="agent-dot"></span>
                    <span class="agent-dot"></span>
                    <span class="agent-dot"></span>
                    <span class="agent-dot"></span>
                  </span>
                  <span class="working-message" id="working-message">팀이 작업 중</span>
                  <span class="working-long-note">파일 5개를 만드느라 몇 분 걸릴 수 있어요</span>
                </div>
                <span class="working-time" id="working-time">0:00</span>
              </div>

              <div class="suggested-row" id="suggested-row" hidden aria-label="추천 후속 질문"></div>

              <form class="composer" id="composer-form">
                <textarea
                  id="composer-input"
                  rows="1"
                  maxlength="12000"
                  placeholder="무엇을 만들어 볼까요?"
                  aria-label="만들고 싶은 내용을 입력하세요"
                  disabled
                ></textarea>
                <button class="send-button" id="send-button" type="submit" disabled aria-label="메시지 보내기">↑</button>
              </form>

              <div class="error-panel" id="error-panel" role="status" aria-live="polite">
                <strong>지금은 팀과 연결할 수 없어요.</strong>
                <div class="error-detail" id="error-detail"></div>
                <button class="retry-button" id="retry-button" type="button">다시 시도 ↻</button>
              </div>

              <p class="chat-hint">AI는 실수할 수 있어요. 중요한 내용은 확인하세요.</p>
            </div>
          </section>
        </div>
      </div>

      <div class="logo-strip" aria-label="사용 기술과 결과물">
        <span>Microsoft Copilot Studio</span>
        <span class="logo-divider">·</span>
        <span>Claude Opus 5.5</span>
        <span class="logo-divider">·</span>
        <span>PowerPoint</span>
        <span class="logo-divider">·</span>
        <span>Word</span>
        <span class="logo-divider">·</span>
        <span>Excel</span>
        <span class="logo-divider">·</span>
        <span>HTML</span>
      </div>
    </section>

    <!-- 숫자 띠 -->
    <section class="container stats" aria-label="팀의 구성과 결과">
      <div class="stat" data-reveal>
        <div class="stat-number"><span data-count="1">1</span><span>번</span></div>
        <div class="stat-label">아이디어 요청</div>
      </div>
      <div class="stat" data-reveal style="--delay:80ms">
        <div class="stat-number"><span data-count="6">6</span><span>명</span></div>
        <div class="stat-label">팀장 1 + 전문가 5</div>
      </div>
      <div class="stat" data-reveal style="--delay:160ms">
        <div class="stat-number"><span data-count="7">7</span><span>개</span></div>
        <div class="stat-label">작업 매뉴얼</div>
      </div>
      <div class="stat" data-reveal style="--delay:240ms">
        <div class="stat-number"><span data-count="5">5</span><span>개</span></div>
        <div class="stat-label">한 번에 받는 파일</div>
      </div>
    </section>

    <!-- 다섯 가지 결과물 -->
    <section class="section features-section" id="features">
      <div class="container">
        <div class="section-heading" data-reveal>
          <span class="eyebrow">Five deliverables.</span>
          <h2>한 번의 요청으로<br>받는 다섯 가지</h2>
          <p>기획부터 디자인, 숫자 검토까지. 각 전문가가 자기 역할에 맞는 결과물을 완성해요.</p>
        </div>

        <div class="bento">
          <!-- 발표자료 -->
          <article class="feature-card" data-reveal>
            <div class="feature-visual">
              <div class="slides-stack" aria-label="세 장의 프레젠테이션 슬라이드 목업">
                <div class="slide slide-one">
                  <div class="slide-accent"></div>
                  <div class="slide-line"></div>
                  <div class="slide-line short"></div>
                  <div class="slide-shape"></div>
                </div>
                <div class="slide slide-two">
                  <div class="slide-accent"></div>
                  <div class="slide-line"></div>
                  <div class="slide-line short"></div>
                  <div class="slide-shape"></div>
                </div>
                <div class="slide slide-three">
                  <div class="slide-accent"></div>
                  <div class="slide-line"></div>
                  <div class="slide-line short"></div>
                  <div class="slide-shape"></div>
                </div>
              </div>
            </div>
            <span class="feature-number">01 / Presentation</span>
            <h3>말할 거리가 정리된 10장</h3>
            <p>10장 내외의 슬라이드와 발표자 노트까지. 흐름이 자연스러운 발표자료를 만들어요.</p>
            <span class="file-name">presentation.pptx</span>
          </article>

          <!-- 포스터 -->
          <article class="feature-card" data-reveal style="--delay:80ms">
            <div class="feature-visual">
              <div class="poster-mock" aria-label="그라데이션 포스터 목업">
                <div class="poster-small">A NEW EXPERIENCE</div>
                <div class="poster-title">MAKE<br>IT<br>MATTER.</div>
                <div class="poster-bottom">CREATIVE CAMPAIGN · 2026</div>
              </div>
            </div>
            <span class="feature-number">02 / Poster</span>
            <h3>걸어 두고 싶은 한 장</h3>
            <p>브라우저에서 바로 여는 유리 질감 포스터. 인쇄하거나 PDF로 저장할 수도 있어요.</p>
            <span class="file-name">poster.html</span>
          </article>

          <!-- 제안서 -->
          <article class="feature-card" data-reveal>
            <div class="feature-visual">
              <div class="document-mock" aria-label="제안서 문서 목업">
                <div class="doc-cover">CREATIVE<br>PROPOSAL</div>
                <div class="doc-content">
                  <div class="doc-heading"></div>
                  <div class="doc-line"></div>
                  <div class="doc-line"></div>
                  <div class="doc-line short"></div>
                  <div class="doc-table"><span></span><span></span><span></span></div>
                  <div class="doc-line"></div>
                  <div class="doc-line short"></div>
                </div>
              </div>
            </div>
            <span class="feature-number">03 / Proposal</span>
            <h3>바로 보낼 수 있는 제안서</h3>
            <p>테마 색을 적용한 표지와 읽기 좋은 본문. 실제 제안에 활용할 수 있도록 구성해요.</p>
            <span class="file-name">proposal.docx</span>
          </article>

          <!-- 웹페이지 -->
          <article class="feature-card" data-reveal style="--delay:80ms">
            <div class="feature-visual">
              <div class="browser-mock" aria-label="미니 브라우저 형태의 웹페이지 목업">
                <div class="browser-bar">
                  <span class="browser-dot"></span>
                  <span class="browser-dot"></span>
                  <span class="browser-dot"></span>
                  <div class="browser-address"></div>
                </div>
                <div class="browser-content">
                  <div class="browser-nav">
                    <div class="browser-logo"></div>
                    <div class="browser-menu"></div>
                  </div>
                  <div class="browser-head"></div>
                  <div class="browser-text"></div>
                  <div class="browser-text"></div>
                  <div class="browser-cards">
                    <div class="browser-card"></div>
                    <div class="browser-card"></div>
                    <div class="browser-card"></div>
                  </div>
                </div>
              </div>
            </div>
            <span class="feature-number">04 / Webpage</span>
            <h3>신청까지 받는 랜딩</h3>
            <p>유리 메뉴 바와 소개 카드로 구성한 웹페이지. 필요에 따라 신청 동선도 설계해요.</p>
            <span class="file-name">webpage.html</span>
          </article>

          <!-- 예산 -->
          <article class="feature-card" data-reveal style="--delay:160ms">
            <div class="feature-visual">
              <div class="budget-mock" aria-label="예산 분석 카드와 막대그래프 목업">
                <div class="budget-caption">TOTAL ESTIMATED BUDGET</div>
                <div class="budget-amount">₩12,400,000 <span class="budget-tag">PLAN</span></div>
                <div class="budget-bars">
                  <div class="budget-bar" style="--bar-height:45%"></div>
                  <div class="budget-bar" style="--bar-height:72%"></div>
                  <div class="budget-bar" style="--bar-height:56%"></div>
                  <div class="budget-bar" style="--bar-height:92%"></div>
                  <div class="budget-bar" style="--bar-height:66%"></div>
                </div>
              </div>
            </div>
            <span class="feature-number">05 / Budget</span>
            <h3>숫자가 맞는 예산</h3>
            <p>예산 카드와 차트, 수식으로 계산하는 합계까지. 기준이 일관된 예산 분석 파일이에요.</p>
            <span class="file-name">budget_analysis.xlsx</span>
          </article>
        </div>
      </div>
    </section>

    <!-- 작동 방식 -->
    <section class="section" id="how">
      <div class="container">
        <div class="section-heading" data-reveal>
          <span class="eyebrow">How the team works.</span>
          <h2>팀장 하나, 전문가 다섯,<br>매뉴얼 일곱.</h2>
          <p>한 번의 브리프를 공유하고, 각자 전문 분야에서 결과물을 완성해요.</p>
        </div>

        <div class="how-grid">
          <div class="orbit-card" data-reveal>
            <div class="orbit" aria-label="팀장을 중심으로 협업하는 다섯 전문가">
              <div class="orbit-ring">
                <span class="agent" style="--a:0deg"><b>ppt-agent</b></span>
                <span class="agent" style="--a:72deg"><b>poster-agent</b></span>
                <span class="agent" style="--a:144deg"><b>proposal-agent</b></span>
                <span class="agent" style="--a:216deg"><b>webpage-agent</b></span>
                <span class="agent" style="--a:288deg"><b>budget-agent</b></span>
              </div>
              <div class="leader">팀장</div>
            </div>
          </div>

          <div class="steps">
            <article class="step" data-reveal>
              <div class="step-number">01</div>
              <div>
                <h3>브리프 — 요청을 기획서로</h3>
                <p>요청을 한 장짜리 기획서로 정리하고, 주제에 맞는 컬러 테마를 정해요.</p>
              </div>
            </article>

            <article class="step" data-reveal style="--delay:80ms">
              <div class="step-number">02</div>
              <div>
                <h3>예산 먼저 — 공통 기준 만들기</h3>
                <p>budget-agent가 예산 기준표를 만들고, 모든 결과물의 금액 기준을 잡아요.</p>
              </div>
            </article>

            <article class="step" data-reveal style="--delay:160ms">
              <div class="step-number">03</div>
              <div>
                <h3>원고 — 전문가별 동시 작업</h3>
                <p>전문가들이 같은 브리프를 바탕으로 각자 필요한 원고와 구성을 만들어요.</p>
              </div>
            </article>

            <article class="step" data-reveal style="--delay:240ms">
              <div class="step-number">04</div>
              <div>
                <h3>파일 5개 — 한 번에 전달</h3>
                <p>공통 디자인 규칙에 맞춰 결과물을 만들고, 파일 다섯 개를 한 번에 첨부해요.</p>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- 디자인 테마 -->
    <section class="design-band" id="design">
      <div class="container design-inner">
        <div class="section-heading" data-reveal>
          <span class="eyebrow">One design language.</span>
          <h2>다섯 파일, 하나의<br>리퀴드 글래스.</h2>
          <p>재질과 레이아웃은 늘 같고, 색만 주제에 맞게 바뀝니다.</p>
        </div>

        <div class="theme-grid">
          <article class="theme-card" data-reveal>
            <div class="theme-swatches">
              <span class="swatch" style="background:#A8D8FF"></span>
              <span class="swatch" style="background:#007AFF"></span>
            </div>
            <h3>스카이</h3>
            <p>교육 · 일반 행사</p>
            <span class="theme-colors">#A8D8FF<br>#007AFF</span>
          </article>

          <article class="theme-card" data-reveal style="--delay:80ms">
            <div class="theme-swatches">
              <span class="swatch" style="background:#1EC8FF"></span>
              <span class="swatch" style="background:#FF2E93"></span>
            </div>
            <h3>팝</h3>
            <p>IT 캠페인 · 축제</p>
            <span class="theme-colors">#1EC8FF<br>#FF2E93</span>
          </article>

          <article class="theme-card" data-reveal style="--delay:160ms">
            <div class="theme-swatches">
              <span class="swatch" style="background:#0B1628"></span>
              <span class="swatch" style="background:#6EA8FF"></span>
            </div>
            <h3>네이비</h3>
            <p>공공 보고서 · 정책</p>
            <span class="theme-colors">#0B1628<br>#6EA8FF</span>
          </article>

          <article class="theme-card" data-reveal style="--delay:240ms">
            <div class="theme-swatches">
              <span class="swatch" style="background:#A8E3C4"></span>
              <span class="swatch" style="background:#12A150"></span>
            </div>
            <h3>그린</h3>
            <p>환경 · ESG</p>
            <span class="theme-colors">#A8E3C4<br>#12A150</span>
          </article>

          <article class="theme-card" data-reveal style="--delay:320ms">
            <div class="theme-swatches">
              <span class="swatch" style="background:#FFC2B3"></span>
              <span class="swatch" style="background:#FF6B4A"></span>
            </div>
            <h3>코럴</h3>
            <p>가족 · 복지</p>
            <span class="theme-colors">#FFC2B3<br>#FF6B4A</span>
          </article>
        </div>
      </div>
    </section>

    <!-- 바로 활용하는 프롬프트 -->
    <section class="section prompts-section" id="prompts">
      <div class="container">
        <div class="section-heading" data-reveal>
          <span class="eyebrow">Ready prompts.</span>
          <h2>이런 요청에 강해요</h2>
          <p>칩을 누르면 입력창에 요청이 채워져요. 내용을 확인하고 직접 전송하세요.</p>
        </div>
      </div>

      <div class="marquee-wrap" aria-label="추천 요청 예시">
        <div class="marquee-track" id="marquee-one">
          <button class="prompt-chip" type="button" data-prompt="가을 학교 축제 기획해 줘">가을 학교 축제</button>
          <button class="prompt-chip" type="button" data-prompt="탄소중립 캠페인 기획해 줘">탄소중립 캠페인</button>
          <button class="prompt-chip" type="button" data-prompt="교사 AI 연수 프로그램 기획해 줘">교사 AI 연수</button>
          <button class="prompt-chip" type="button" data-prompt="신제품 런칭 행사 기획해 줘">신제품 런칭 행사</button>
          <button class="prompt-chip" type="button" data-prompt="진로 체험 주간 기획해 줘">진로 체험 주간</button>
          <button class="prompt-chip" type="button" data-prompt="지역 축제 홍보 기획해 줘">지역 축제 홍보</button>
          <button class="prompt-chip" type="button" data-prompt="고객 제안 워크숍 기획해 줘">고객 제안 워크숍</button>
          <button class="prompt-chip" type="button" data-prompt="학부모 설명회 기획해 줘">학부모 설명회</button>
          <button class="prompt-chip" type="button" data-prompt="해커톤 행사 기획해 줘">해커톤</button>
          <button class="prompt-chip" type="button" data-prompt="동아리 박람회 기획해 줘">동아리 박람회</button>
        </div>

        <div class="marquee-track reverse" id="marquee-two" aria-hidden="true">
          <button class="prompt-chip" type="button" tabindex="-1">브랜드 캠페인</button>
          <button class="prompt-chip" type="button" tabindex="-1">환경의 날 행사</button>
          <button class="prompt-chip" type="button" tabindex="-1">진로 체험 주간</button>
          <button class="prompt-chip" type="button" tabindex="-1">지역 축제 홍보</button>
          <button class="prompt-chip" type="button" tabindex="-1">학교 설명회</button>
          <button class="prompt-chip" type="button" tabindex="-1">AI 교육 프로그램</button>
          <button class="prompt-chip" type="button" tabindex="-1">신제품 런칭 행사</button>
          <button class="prompt-chip" type="button" tabindex="-1">해커톤</button>
          <button class="prompt-chip" type="button" tabindex="-1">동아리 박람회</button>
          <button class="prompt-chip" type="button" tabindex="-1">탄소중립 캠페인</button>
        </div>
      </div>
    </section>

    <!-- 마지막 CTA -->
    <section class="cta-shell">
      <div class="cta-panel mesh" data-reveal>
        <span class="eyebrow">Your turn.</span>
        <h2>지금, 아이디어 한 줄을<br><span class="gradient-text">적어 보세요.</span></h2>
        <button class="pill pill-dark cta-button" type="button" data-chat-jump>
          대화 시작하기 <span aria-hidden="true">↑</span>
        </button>
      </div>
    </section>
  </main>

  <footer class="container footer">
    <div class="footer-brand">AI Creative Agent Team</div>
    <div>Copilot Studio로 만든 멀티 에이전트</div>
    <div>© 2026 AI Creative Agent Team</div>
  </footer>

  <!-- 채팅창이 화면 밖에 있을 때 표시 -->
  <button class="floating-status" id="floating-status" type="button" aria-label="대화창으로 이동">
    <span class="float-dot" aria-hidden="true"></span>
    <span id="floating-label">팀이 작업 중 · 0:00</span>
    <span aria-hidden="true">↑</span>
  </button>

  <script>
    /* ① 등장 효과, 숫자, 내비게이션 */
    (() => {
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const body = document.body;

      if (!reducedMotion && "IntersectionObserver" in window) {
        body.classList.add("reveal-ready");

        document.querySelectorAll("[data-reveal]").forEach((element) => {
          if (element.closest(".hero")) return;
        });

        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.12, rootMargin: "0px 0px -30px 0px" });

        document.querySelectorAll("[data-reveal]").forEach((element) => {
          revealObserver.observe(element);
        });
      } else {
        document.querySelectorAll("[data-reveal]").forEach((element) => {
          element.classList.add("is-visible");
        });
      }

      // 숫자는 해당 띠가 화면에 들어오면 0부터 증가
      const stats = document.querySelector(".stats");
      const countElements = document.querySelectorAll("[data-count]");
      let counted = false;

      function animateCounts() {
        if (counted) return;
        counted = true;

        countElements.forEach((element) => {
          const target = Number(element.dataset.count);
          if (reducedMotion) {
            element.textContent = target;
            return;
          }

          const duration = 1000;
          const start = performance.now();

          function tick(now) {
            const progress = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 4);
            element.textContent = Math.round(target * eased);
            if (progress < 1) requestAnimationFrame(tick);
          }

          element.textContent = "0";
          requestAnimationFrame(tick);
        });
      }

      if ("IntersectionObserver" in window && stats) {
        const statsObserver = new IntersectionObserver((entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            animateCounts();
            statsObserver.disconnect();
          }
        }, { threshold: 0.25 });
        statsObserver.observe(stats);
      } else {
        animateCounts();
      }

      // 현재 보이는 섹션에 맞춰 내비게이션 링크 강조
      const navLinks = [...document.querySelectorAll(".nav-links a")];
      const sections = navLinks
        .map((link) => document.querySelector(link.getAttribute("href")))
        .filter(Boolean);

      if ("IntersectionObserver" in window) {
        const navObserver = new IntersectionObserver((entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

          if (!visible) return;

          navLinks.forEach((link) => {
            const active = link.getAttribute("href") === "#" + visible.target.id;
            link.classList.toggle("active", active);
            if (active) link.setAttribute("aria-current", "location");
            else link.removeAttribute("aria-current");
          });
        }, { rootMargin: "-18% 0px -60% 0px", threshold: [0, .1, .25, .5] });

        sections.forEach((section) => navObserver.observe(section));
      }
    })();

    /* ② 대화창 동작 */
    const chatCard = document.getElementById("chat-card");
    const chatInput = document.getElementById("composer-input");
    const composerForm = document.getElementById("composer-form");
    const sendButton = document.getElementById("send-button");
    const exampleRow = document.getElementById("example-row");
    const suggestedRow = document.getElementById("suggested-row");
    const workingMessage = document.getElementById("working-message");
    const workingTime = document.getElementById("working-time");
    const floatingStatus = document.getElementById("floating-status");
    const floatingLabel = document.getElementById("floating-label");
    const connectionLabel = document.getElementById("connection-label");
    const errorPanel = document.getElementById("error-panel");
    const errorDetail = document.getElementById("error-detail");

    let connected = false;
    let started = false;
    let working = false;
    let workStartedAt = 0;
    let resultArrived = false;
    let lastError = "";
    let webChatStore = null;
    let directLineInstance = null;
    let chatVisible = true;
    let workingInterval = null;
    let lastAgentActivityAt = 0;

    // 모든 이동 버튼이 같은 스크롤 방식 사용
    function scrollToChat() {
      window.scrollTo({
        top: chatCard.getBoundingClientRect().top + window.scrollY - 88,
        behavior: "smooth"
      });

      window.setTimeout(() => {
        chatInput.focus({ preventScroll: true });
      }, 450);
    }

    document.querySelectorAll("[data-chat-jump]").forEach((button) => {
      button.addEventListener("click", scrollToChat);
    });

    floatingStatus.addEventListener("click", scrollToChat);

    // 화면에서 채팅 카드가 보이는지 확인
    if ("IntersectionObserver" in window) {
      const chatVisibilityObserver = new IntersectionObserver((entries) => {
        chatVisible = entries[0].isIntersecting;
        updateFloatingStatus();
      }, { threshold: 0.15 });

      chatVisibilityObserver.observe(chatCard);
    }

    function formatElapsed(milliseconds) {
      const total = Math.max(0, Math.floor(milliseconds / 1000));
      const minutes = Math.floor(total / 60);
      const seconds = total % 60;
      return minutes + ":" + String(seconds).padStart(2, "0");
    }

    function updateFloatingStatus() {
      const shouldShow = !chatVisible && (working || resultArrived);
      floatingStatus.classList.toggle("show", shouldShow);

      if (working) {
        floatingLabel.textContent = "팀이 작업 중 · " + formatElapsed(Date.now() - workStartedAt);
      } else if (resultArrived) {
        floatingLabel.textContent = "결과가 도착했어요";
      }
    }

    function updateComposerState() {
      chatInput.disabled = !connected || working;
      sendButton.disabled = !connected || working || !chatInput.value.trim();
    }

    function resizeInput() {
      chatInput.style.height = "auto";
      chatInput.style.height = Math.min(chatInput.scrollHeight, 156) + "px";
      chatInput.style.overflowY = chatInput.scrollHeight > 156 ? "auto" : "hidden";
    }

    function setWorking(value) {
      working = value;
      document.body.classList.toggle("is-working", value);
      document.body.classList.toggle("is-working-long", value && Date.now() - workStartedAt >= 20000);

      if (value) {
        workingMessage.textContent = "팀이 작업 중";
        resultArrived = false;
        updateFloatingStatus();

        if (workingInterval) clearInterval(workingInterval);
        workingInterval = window.setInterval(() => {
          workingTime.textContent = formatElapsed(Date.now() - workStartedAt);
          document.body.classList.toggle("is-working-long", Date.now() - workStartedAt >= 20000);
          updateFloatingStatus();
        }, 1000);
      } else {
        if (workingInterval) {
          clearInterval(workingInterval);
          workingInterval = null;
        }
        document.body.classList.remove("is-working-long");
      }

      updateComposerState();
      updateFloatingStatus();
    }

    function setConnected(value) {
      connected = value;
      document.body.classList.toggle("is-connected", value);

      if (value) {
        document.body.classList.remove("is-error");
        connectionLabel.textContent = "연결됨";
      } else {
        connectionLabel.textContent = "팀을 부르는 중…";
      }

      updateComposerState();
    }

    function showError(message) {
      lastError = String(message || "알 수 없는 오류");
      document.body.classList.add("is-error");
      document.body.classList.remove("is-connected");
      connectionLabel.textContent = "연결 오류";
      errorDetail.textContent = lastError;
      setConnected(false);
      setWorking(false);
      chatInput.disabled = true;
      sendButton.disabled = true;
    }

    // Web Chat이 보내는 제안 버튼을 자체 유리 칩으로 표시
    function showSuggestedActions(actions) {
      suggestedRow.replaceChildren();

      if (!Array.isArray(actions) || actions.length === 0) {
        suggestedRow.hidden = true;
        return;
      }

      actions.forEach((action) => {
        if (!action || !action.title) return;

        const button = document.createElement("button");
        button.type = "button";
        button.className = "suggested-chip";
        button.textContent = action.title;

        button.addEventListener("click", () => {
          if (!connected || working) return;

          const value = action.value;
          if (typeof value === "string" && value.trim()) {
            sendMessage(value);
          } else if (value && typeof value === "object" && value.type === "openUrl" && value.value) {
            window.open(value.value, "_blank", "noopener,noreferrer");
          } else {
            sendMessage(action.title);
          }
        });

        suggestedRow.appendChild(button);
      });

      suggestedRow.hidden = suggestedRow.children.length === 0;
    }

    function sendMessage(value) {
      const text = String(value || "").trim();
      if (!text || !connected || !webChatStore || working) return;

      // 첫 사용자 메시지에서만 대화창을 확장
      if (!started) {
        started = true;
        document.body.classList.add("is-started");
        exampleRow.hidden = true;

        requestAnimationFrame(() => {
          window.scrollTo({
            top: chatCard.getBoundingClientRect().top + window.scrollY - 88,
            behavior: "smooth"
          });
        });
      }

      resultArrived = false;
      workStartedAt = Date.now();
      workingTime.textContent = "0:00";
      setWorking(true);

      chatInput.value = "";
      resizeInput();
      updateComposerState();

      webChatStore.dispatch({
        type: "WEB_CHAT/SEND_MESSAGE",
        payload: { text }
      });
    }

    composerForm.addEventListener("submit", (event) => {
      event.preventDefault();
      sendMessage(chatInput.value);
    });

    chatInput.addEventListener("input", () => {
      resizeInput();
      updateComposerState();
    });

    chatInput.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" || event.shiftKey) return;
      if (event.isComposing || event.keyCode === 229) return;

      event.preventDefault();
      if (!sendButton.disabled) composerForm.requestSubmit();
    });

    // 처음 예시 칩은 클릭 즉시 전송
    exampleRow.addEventListener("click", (event) => {
      const button = event.target.closest("[data-prompt]");
      if (!button || !exampleRow.contains(button)) return;
      sendMessage(button.dataset.prompt);
    });

    // 프롬프트 마키 칩은 전송하지 않고 입력창에 채움
    document.querySelectorAll("#marquee-one [data-prompt]").forEach((button) => {
      button.addEventListener("click", () => {
        const prompt = button.dataset.prompt;
        if (!prompt) return;

        scrollToChat();
        chatInput.value = prompt;
        resizeInput();
        updateComposerState();

        window.setTimeout(() => {
          chatInput.focus({ preventScroll: true });
          chatInput.setSelectionRange(chatInput.value.length, chatInput.value.length);
        }, 450);
      });
    });

    // 새 대화는 Web Chat 세션을 다시 시작
    document.getElementById("new-chat").addEventListener("click", () => {
      if (!connected) {
        retryConnection();
        return;
      }

      const confirmed = window.confirm("새 대화를 시작할까요? 현재 대화 기록은 화면에서 초기화됩니다.");
      if (!confirmed) return;

      window.location.reload();
    });

    function retryConnection() {
      window.location.reload();
    }

    document.getElementById("retry-button").addEventListener("click", retryConnection);

    /* ③ 원래 Copilot Studio 연결 코드 */
    const BROKER_URL = "https://dl-broker-juwon-4jt3z.azurewebsites.net/api/directlineToken";
    const SEALED = "MOpU5H0cVYDHbglKLzxIYuv7wBi9XpcP7BTc4WWuIoc1dY8ZtLE6R-gyxRWM_7ne6p_mZmLVLNh6zGIdYW0vgY9lGUFx7KYDkGBbKLyoXY34-QZ09QPJBTVfAFRFeFRfJRZCbqSwbjvPWrEZv2HkElr-KollvEW4831KcWZsazSEWLZRDyKlsCkQtxAPYKZiUkNNULBOpYLjVJhjZZa073UjHA53hVQbHvayAYVrAVW1HtP9HmCiZQcF8IbVyk6Zvh233H66mmEUn6NzrIefbhcxmDA8YoaAN0FrTe91gLHBidv5o094t4dN-letMXxh3AXSqQ2Vu1E-kJn5q-un3HGabXGJOk64UZDyllaKtTOFzbh7xJs4PGvhSagOYvxUT7y9B-5dIPX_SmCAEbkHqX9AWzr88Ywd_fUUCJT5tXAyWu-9kMgHgzj96ipVWCSuCyjg9cCD8w6IoGnI0jNOk4WEdhVD4iYAJJPFC665pxQm6p-xW9htjr0x9tI3MfNbHA3Api4jmw6Dl0xqqWQ3xK52lf6o2jLtQIot7Itskk23W6fK6GqMn1sdXeBNQGiaAOfQd4wrh0MrVU06mbuO9oXxmSV8DmeoJmx4WtFbWrmf1X2KXYT69X7_EBwE4E9AuEeDUfcheutjyNXtIazxSg89sw";

    async function connect() {
      if (!window.WebChat ||
          typeof WebChat.createDirectLine !== "function" ||
          typeof WebChat.renderWebChat !== "function") {
        showError("채팅 구성 요소를 불러오지 못했습니다. 네트워크를 확인한 뒤 새로고침해 주세요.");
        return;
      }

      let response;
      try {
        // 단순 CORS 요청을 유지
        response = await fetch(BROKER_URL, {
          method: "POST",
          body: JSON.stringify({ sealed: SEALED })
        });
      } catch (error) {
        showError("서버에 연결하지 못했습니다. 네트워크와 배포 주소를 확인해 주세요. " + error.message);
        return;
      }

      if (!response.ok) {
        showError("서버가 연결 요청을 처리하지 못했습니다 (HTTP " + response.status + ").");
        return;
      }

      let data;
      try {
        data = await response.json();
      } catch (error) {
        showError("서버 응답을 읽을 수 없습니다. 잠시 후 다시 시도해 주세요. " + error.message);
        return;
      }

      if (!data || typeof data.token !== "string" || !data.token.trim()) {
        showError("서버에서 연결 토큰을 받지 못했습니다. 암호와 배포 주소를 확인해 주세요.");
        return;
      }

      try {
        directLineInstance = WebChat.createDirectLine({ token: data.token });

        // Direct Line 연결과 수신 이벤트를 관찰하는 스토어
        const middleware = () => (next) => (action) => {
          const result = next(action);

          if (action.type === "DIRECT_LINE/CONNECT_FULFILLED") {
            setConnected(true);
          }

          if (action.type === "DIRECT_LINE/CONNECT_REJECTED") {
            showError("Direct Line 연결에 실패했습니다. " +
              (action.payload && action.payload.message ? action.payload.message : ""));
          }

          if (action.type === "DIRECT_LINE/INCOMING_ACTIVITY") {
            const activity = action.payload && action.payload.activity;

            if (activity && activity.from && activity.from.role !== "user") {
              lastAgentActivityAt = Date.now();

              // 타이핑 활동은 완료 신호가 아님
              if (activity.type === "message") {
                setWorking(false);
                resultArrived = true;
                updateFloatingStatus();
              }

              if (activity.suggestedActions && activity.suggestedActions.actions) {
                showSuggestedActions(activity.suggestedActions.actions);
              }

              // openUrl 제안 외에 직접 링크가 담긴 활동은 Web Chat 기본 렌더러가 처리
              if (activity.type === "message" && activity.text) {
                suggestedRow.hidden = !suggestedRow.children.length;
              }
            }
          }

          return result;
        };

        webChatStore = WebChat.createStore({}, middleware);

        // Web Chat의 첫 인사는 Web Chat 자체가 렌더링
        directLineInstance.postActivity({
          type: "event",
          name: "startConversation",
          from: { id: "user" }
        }).subscribe({
          error: (error) => {
            showError("첫 인사를 요청하지 못했습니다. " +
              (error && error.message ? error.message : "채팅창에 메시지를 입력해 주세요."));
          }
        });

        WebChat.renderWebChat({
          directLine: directLineInstance,
          store: webChatStore,
          locale: "ko-KR",
          styleOptions: {
            hideSendBox: true,
            rootHeight: "100%",
            backgroundColor: "transparent",
            primaryFont: "'Pretendard Variable', -apple-system, sans-serif",
            bubbleBackground: "transparent",
            bubbleBorderWidth: 0,
            bubbleMaxWidth: 720,
            bubbleMinWidth: 0,
            bubbleFromUserBackground: "linear-gradient(135deg, #EEF0FF, #FBEFFF)",
            bubbleFromUserBorderWidth: 0,
            bubbleFromUserBorderRadius: 20
          }
        }, document.getElementById("webchat"));

        // CONNECT_FULFILLED 이벤트 전까지 입력창은 비활성 상태
        setConnected(false);
      } catch (error) {
        showError("채팅을 시작하지 못했습니다. " +
          (error && error.message ? error.message : "새로고침 후 다시 시도해 주세요."));
      }
    }

    connect();
  </script>
</body>
</html>
